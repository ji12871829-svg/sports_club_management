# ── Apex Sports Club – .htaccess performance rules ──────────────────
# Enables GZIP compression, browser caching, and security headers.
# Place in the project root (alongside admin/ and public/).

<IfModule mod_deflate.c>
    # GZIP text-based assets (saves 60-80% bandwidth)
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
    AddOutputFilterByType DEFLATE application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
    # Enable Expires directives
    ExpiresActive On

    # CSS & JS — 1 week (cache-busted via filemtime query strings)
    ExpiresByType text/css                 "access plus 1 week"
    ExpiresByType text/javascript          "access plus 1 week"
    ExpiresByType application/javascript   "access plus 1 week"

    # Images — 1 month
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/gif                "access plus 1 month"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType image/x-icon             "access plus 1 year"

    # Fonts — 1 year (CDN fonts rarely change)
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"

    # PDFs
    ExpiresByType application/pdf          "access plus 1 month"

    # HTML — no cache (always fresh)
    ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# ── Cache-Control headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    # Static assets: immutable + long cache
    <FilesMatch "\.(css|js|woff2|woff|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico|pdf)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # HTML: no cache
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Security headers — "always" so 4xx/5xx responses (custom 404 page,
    # CSRF 403s) carry the same headers as successful pages.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS — browsers only honour it over HTTPS, so it is safe to set always.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP — relaxed enough for the app (CDN assets + inline styles/scripts,
    # OSM map tiles, QuickChart QR images) while still blocking unknown
    # script origins, plugins, framing and form-action hijacking.
    # NOTE: script-src keeps 'unsafe-inline' because pages use inline
    # handlers; moving to nonces/hashes is the future hardening path.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://quickchart.io https://*.tile.openstreetmap.org https://www.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; frame-src 'self'"
</IfModule>

# ── Prevent directory listing ──────────────────────────────────────
Options -Indexes

# ── Custom error pages ────────────────────────────────────────────
# Project-relative path (no leading slash) so ErrorDocument resolves
# relative to the directory containing this .htaccess — works from any
# deployment folder (e.g. /Apex Sports Club/ or the web root).
ErrorDocument 404 public/404.php
ErrorDocument 403 public/404.php

# ── Block access to sensitive files ────────────────────────────────
<FilesMatch "\.(env|git|log|sql|bak|ini|htaccess)$">
    Require all denied
</FilesMatch>

# ── PHP tuning (if mod_php is loaded) ──────────────────────────────
<IfModule mod_php.c>
    php_value max_execution_time 30
    php_value memory_limit 256M
    php_flag display_errors Off
</IfModule>
