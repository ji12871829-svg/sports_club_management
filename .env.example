# ============================================================
#  Apex Sports Club — .env.example
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#  Environment selection (Twelve-Factor parity):
#    APP_ENV=development | staging | production
#  Optional per-env overlays that WIN over this file:
#    .env.staging, .env.production  (values override base .env)
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=0
SITE_URL=
APP_URL=

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sports_club_db

# ── Club details ─────────────────────────────────────────────
CLUB_EMAIL_FROM=
CLUB_EMAIL_NAME=Apex Sports Club
CLUB_WHATSAPP_PHONE=
CLUB_WHATSAPP_GREETING=
CLUB_LAT=-1.286389
CLUB_LNG=36.817223
CLUB_CITY=Nairobi

# ── Email (Brevo) ────────────────────────────────────────────
BREVO_API_KEY=

# ── Payments: Paystack ───────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://your-domain.example/callbacks/paystack_callback.php

# ── Payments: M-Pesa Daraja ──────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a real https:// URL — Safaricom rejects http:// with
# 400.002.02 "Invalid CallBackURL".
MPESA_CALLBACK_URL=https://your-ngrok-domain.ngrok-free.app/callbacks/mpesa_callback.php

# ── Bots / security ──────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
CRON_SECRET=
# Trust X-Forwarded-* from a reverse proxy for rate limiting (1 to enable).
ASC_TRUST_PROXY=0

# ── AI (Gemini / OpenRouter) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
API_SPORTS_KEY=

# ── Ticketing ────────────────────────────────────────────────
TICKET_DEFAULT_PRICE=

# ── Alerting (cron emails) ───────────────────────────────────
ASC_PAYMENT_ALERT_EMAIL_TO=
ASC_PROFILER_EMAIL_TO=
ASC_PROFILER_SLOW_MS=100
ASC_SECURITY_EMAIL_TO=
ASC_SECURITY_RETENTION_DAYS=30
ASC_SECURITY_MIN_CRITICAL=1

# ── Tooling / scripts ────────────────────────────────────────
ASC_DEBUG=0
ASC_REPAIR_MEMBER_PASSWORD=
ASC_REPAIR_ADMIN_PASSWORD=
ASC_REPAIR_ADMIN_EMAIL=
