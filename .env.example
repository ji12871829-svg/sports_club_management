# Copy this file to .env and fill in real values on your local machine/server.
# Never commit .env to GitHub.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sports_club_db

BREVO_API_KEY=
CLUB_EMAIL_FROM=your_email@example.com
CLUB_EMAIL_NAME=Apex Sports Club

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

API_SPORTS_KEY=

# AI provider keys (either one enables the AI features: booking review, match reports, smart scheduling)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost/sports_club_management/paystack_callback.php

# M-Pesa Daraja sandbox credentials
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-ngrok-domain.ngrok-free.app/sports_club_management/mpesa_callback.php
MPESA_ENV=sandbox

CLUB_LAT=-1.286389
CLUB_LNG=36.817223
CLUB_CITY=Nairobi

# Full site URL used for links inside outgoing emails. Auto-detected from the request;
# set it explicitly when behind a reverse proxy or for CLI/cron email jobs.
# SITE_URL=https://example.com

# Profiler: slow-page daily email digest (cron_profiler_alert.php). Leave empty to disable.
# ASC_PROFILER_EMAIL_TO=admin@sportsclub.com
# ASC_PROFILER_ALERT_MS=500
# ASC_PROFILER_SLOW_MS=100
# Set ASC_DEBUG=1 to show the profiler badge on public pages too.
# ASC_DEBUG=0

# ── Security digest ──────────────────────────────────────────────────────
# Daily email summary of security events (rate-limit hits, CSRF rejections,
# webhook/callback failures, auth lockouts) via cron_security_alert.php.
# Leave empty to disable. Threshold: min events before an email is sent
# (default 0 = always email). Events are stored in the `security_events`
# table (migration 057) and retained ~30 days.
# ASC_SECURITY_EMAIL_TO=admin@sportsclub.com
# ASC_SECURITY_MIN_CRITICAL=0

# ── Object storage ────────────────────────────────────────────────────────
# Where uploaded media lives. 'local' stores files under uploads/ (default,
# no config needed). 's3' stores them in any S3-compatible bucket (AWS S3,
# Cloudflare R2, MinIO, DigitalOcean Spaces…) via Signature V4 + cURL.
# ASC_STORAGE_DRIVER=local
# ASC_S3_ENDPOINT=https://<bucket-endpoint>    # e.g. R2 account endpoint
# ASC_S3_REGION=us-east-1
# ASC_S3_BUCKET=apex-sports-club
# ASC_S3_ACCESS_KEY=
# ASC_S3_SECRET_KEY=
# ASC_S3_PUBLIC_URL=    # optional public CDN URL for bucket objects
