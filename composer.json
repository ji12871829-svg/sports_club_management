{
    "name": "apex-sports-club/app",
    "description": "Apex Sports Club Management System",
    "type": "project",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "config/api_config.php",
            "includes/input_sanitize.php",
            "includes/password_policy.php",
            "includes/feature_helpers.php",
            "includes/activity_log.php",
            "includes/csrf.php",
            "includes/roles.php",
            "includes/url.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:summary": "php scripts/run_tests.php"
    }
}
